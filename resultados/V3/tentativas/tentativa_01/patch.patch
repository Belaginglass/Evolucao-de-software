+<!DOCTYPE html>
+<html xmlns:th="http://www.thymeleaf.org">
+<head>
+    <meta charset="UTF-8">
+    <title>DogTech - Cadastro de Animal [PRT-7]</title>
+    <script>
+        function atualizarRacas() {
+            let especie = document.getElementById('especie').value;
+            let selectRaca = document.getElementById('raca');
+            selectRaca.innerHTML = '';
+            
+            let racasCachorro = ["SRD (Vira-lata)", "Poodle", "Labrador", "Golden Retriever", "Bulldog", "Pastor Alemão"];
+            let racasGato = ["SRD (Vira-lata)", "Siamês", "Persa", "Angorá", "Maine Coon"];
+            
+            let lista = (especie === 'Felina') ? racasGato : racasCachorro;
+            lista.forEach(r => {
+                let opt = document.createElement('option');
+                opt.value = r;
+                opt.textContent = r;
+                selectRaca.appendChild(opt);
+            });
+        }
+
+        function verificarRegrasAutomaticas() {
+            let tombado = document.getElementById('patrimonioTombado').value;
+            let emTratamento = document.getElementById('emTratamento').value;
+            let disponivel = document.getElementById('disponivelAdocao');
+
+            if (tombado === 'Sim' || emTratamento === 'Sim') {
+                disponivel.value = 'Não';
+            }
+        }
+
+        window.onload = function() {
+            atualizarRacas();
+        };
+    </script>
+</head>
+<body>
+    <h2>DogTech - Cadastro de Animal [PRT-7] (UC003)</h2>
+
+    <div th:if="${erro}" style="color: red;">
+        <p th:text="${erro}"></p>
+    </div>
+    <div th:if="${sucesso}" style="color: green;">
+        <p th:text="${sucesso}"></p>
+    </div>
+
+    <form action="/animais/novo" method="post" enctype="multipart/form-data">
+        <label>Espécie: <span title="Canina ou Felina">?</span></label>
+        <select id="especie" name="especie" onchange="atualizarRacas()" required>
+            <option value="Canina">Canina</option>
+            <option value="Felina">Felina</option>
+        </select><br><br>
+
+        <label>Sexo: <span title="Macho ou Fêmea">?</span></label>
+        <select name="sexo" required>
+            <option value="Macho">Macho</option>
+            <option value="Fêmea">Fêmea</option>
+        </select><br><br>
+
+        <label>Castrado?: <span title="Sim ou Não">?</span></label>
+        <select name="castrado" required>
+            <option value="Sim">Sim</option>
+            <option value="Não">Não</option>
+        </select><br><br>
+
+        <label>Vermifugado?: <span title="Sim ou Não">?</span></label>
+        <select name="vermifugado" required>
+            <option value="Sim">Sim</option>
+            <option value="Não">Não</option>
+        </select><br><br>
+
+        <label>Idade Aproximada (Opcional): <span title="Ex: 2 anos">?</span></label>
+        <input type="text" name="idadeAproximada"><br><br>
+
+        <label>Raça: <span title="Raça conforme espécie (RNF004)">?</span></label>
+        <select id="raca" name="raca" required></select><br><br>
+
+        <label>Temperamento (Opcional, múltiplos): <span title="Selecione características de temperamento">?</span></label><br>
+        <input type="checkbox" name="temperamento" value="Dócil"> Dócil
+        <input type="checkbox" name="temperamento" value="Agressivo"> Agressivo
+        <input type="checkbox" name="temperamento" value="Arisco"> Arisco
+        <input type="checkbox" name="temperamento" value="Bipolar"> Bipolar
+        <input type="checkbox" name="temperamento" value="Não sociável com outros animais"> Não sociável com outros
+        <input type="checkbox" name="temperamento" value="Temperamental"> Temperamental<br><br>
+
+        <label>Porte (Opcional): <span title="Pequeno, Médio ou Grande">?</span></label>
+        <select name="porte">
+            <option value="">Nenhum</option>
+            <option value="Pequeno">Pequeno (<=10kg)</option>
+            <option value="Medium">Médio (<=25kg)</option>
+            <option value="Grande">Grande (>25kg)</option>
+        </select><br><br>
+
+        <label>Fotos (Opcional, múltiplos arquivos): <span title="JPG, PNG">?</span></label>
+        <input type="file" name="fotosFiles" accept=".jpg, .jpeg, .png" multiple><br><br>
+
+        <label>Nome de Referência: <span title="Nome ou apelido do animal">?</span></label>
+        <input type="text" name="nomeReferencia" required><br><br>
+
+        <label>História: <span title="História de resgate do animal">?</span></label>
+        <textarea name="historia" required></textarea><br><br>
+
+        <label>É patrimônio tombado?: <span title="Sim ou Não">?</span></label>
+        <select id="patrimonioTombado" name="patrimonioTombado" onchange="verificarRegrasAutomaticas()" required>
+            <option value="Não">Não</option>
+            <option value="Sim">Sim</option>
+        </select><br><br>
+
+        <label>Está em tratamento?: <span title="Sim ou Não">?</span></label>
+        <select id="emTratamento" name="emTratamento" onchange="verificarRegrasAutomaticas()" required>
+            <option value="Não">Não</option>
+            <option value="Sim">Sim</option>
+        </select><br><br>
+
+        <label>Está disponível para adoção?: <span title="Definido automaticamente se tombado ou em tratamento">?</span></label>
+        <select id="disponivelAdocao" name="disponivelAdocao" required>
+            <option value="Sim">Sim</option>
+            <option value="Não">Não</option>
+        </select><br><br>
+
+        <label>Vacinas (Nome, Doses e Datas): <span title="Informações de vacinação (UC003/RF014)">?</span></label>
+        <input type="text" name="vacinasJson" placeholder="Ex: Raiva - 1 dose - 10/01/2024"><br><br>
+
+        <label>Baia (Opcional): <span title="Número ou nome da baia">?</span></label>
+        <input type="text" name="baia"><br><br>
+
+        <label>Outras Informações:</label>
+        <textarea name="outrasInformacoes"></textarea><br><br>
+
+        <label>Autor da Fotografia: <span title="Nome do fotógrafo responsável">?</span></label>
+        <input type="text" name="autorFotografia" required><br><br>
+
+        <label>Contato do Autor (Opcional): <span title="E-mail, telefone ou rede social do autor">?</span></label>
+        <input type="text" name="contatoAutor"><br><br>
+
+        <button type="submit">Salvar Animal</button>
+        <a href="/home-admin"><button type="button">Cancelar</button></a>
+    </form>
+</body>
+</html>

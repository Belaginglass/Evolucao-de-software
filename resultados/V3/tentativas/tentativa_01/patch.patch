+package com.tcc.iterativa.service;
+
+import com.tcc.iterativa.model.Animal;
+import com.tcc.iterativa.repository.AnimalRepository;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+@SpringBootTest
+class AnimalServiceI3Test {
+
+    @Autowired
+    private AnimalService animalService;
+
+    @Autowired
+    private AnimalRepository animalRepository;
+
+    @BeforeEach
+    void setUp() {
+        animalRepository.deleteAll();
+    }
+
+    @Test
+    void testCadastrarAnimalSucesso() throws Exception {
+        Animal a = animalService.cadastrar(
+            "Canina", "Macho", "Sim", "Sim",
+            "2 anos", "Labrador", "Dócil", "Médio",
+            null, "Rex", "Resgatado da rua", "Não",
+            "Não", "Sim", "Raiva - 1 dose", "Baia 1",
+            "Nenhuma", "João Fotógrafo", "joao@foto.com"
+        );
+
+        assertNotNull(a.getId());
+        assertEquals("Rex", a.getNomeReferencia());
+        assertEquals("Sim", a.getDisponivelAdocao());
+    }
+
+    @Test
+    void testRegraAutomaticaPatrimonioTombado() throws Exception {
+        Animal a = animalService.cadastrar(
+            "Felina", "Fêmea", "Sim", "Sim",
+            "1 ano", "Siamês", "Arisco", "Pequeno",
+            null, "Mimi", "Encontrada no telhado", "Sim",
+            "Não", "Sim", null, null,
+            null, "Maria", null
+        );
+
+        assertNotNull(a.getId());
+        assertEquals("Sim", a.getPatrimonioTombado());
+        assertEquals("Não", a.getDisponivelAdocao());
+    }
+
+    @Test
+    void testCadastrarAnimalFalhaFaltaObrigatorio() {
+        assertThrows(IllegalArgumentException.class, () -> {
+            animalService.cadastrar(
+                null, "Macho", "Sim", "Sim",
+                null, "Labrador", null, null,
+                null, "Rex", "História", "Não",
+                "Não", "Sim", null, null,
+                null, "João", null
+            );
+        });
+    }
+}

+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @Column(nullable = false)
+    private String especie; // Canina / Felina
+
+    @Column(nullable = false)
+    private String sexo; // Macho / Fêmea
+
+    @Column(nullable = false)
+    private String castrado; // Sim / Não
+
+    @Column(nullable = false)
+    private String vermifugado; // Sim / Não
+
+    private String idadeAproximada;
+
+    @Column(nullable = false)
+    private String raca;
+
+    private String temperamento; // Múltiplos separados por vírgula
+
+    private String porte;
+
+    @Column(columnDefinition = "TEXT")
+    private String fotos; // JSON ou URLs/Base64 separados por ponto e vírgula
+
+    @Column(nullable = false)

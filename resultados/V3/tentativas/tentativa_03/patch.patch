+import java.util.ArrayList;
+import java.util.List;
+
+@Entity
+@Table(name = "animais")
+public class Animal {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @Column(nullable = false)
+    private String especie; // Canina / Felina
+
+    @Column(nullable = false)
+    private String sexo; // Macho / Fêmea
+
+    @Column(nullable = false)
+    private String castrado; // Sim / Não
+
+    @Column(nullable = false)
+    private String vermifugado; // Sim / Não
+
+    private String idadeAproximada;
+
+    @Column(nullable = false)
+    private String raca;
+
+    private String temperamento; // Múltiplos separados por vírgula
+
+    private String porte;
+
+    @Column(columnDefinition = "TEXT")
+    private String fotos; // JSON ou URLs/Base64 separados por ponto e vírgula
+
+    @Column(nullable = false)
+    private String nomeReferencia;
+
+    @Column(columnDefinition = "TEXT", nullable = false)
+    private String historia;
+
+    @Column(nullable = false)
+    private String patrimonioTombado; // Sim / Não
+
+    @Column(nullable = false)
+    private String emTratamento; // Sim / Não
+
+    @Column(nullable = false)
+    private String disponivelAdocao; // Sim / Não
+
+    @Column(columnDefinition = "TEXT")
+    private String vacinasJson; // Armazena vacinas (nome, doses, datas)
+
+    @ManyToOne
+    @JoinColumn(name = "baia_id")
+    private Baia baia;
+
+    @Column(columnDefinition = "TEXT")
+    private String outrasInformacoes;
+
+    @Column(nullable = false)
+    private String autorFotografia;
+
+    private String contatoAutor;
+
+    public Animal() {}
+
+    public Long getId() { return id; }
+    public void setId(Long id) { this.id = id; }
+
+    public String getEspecie() { return especie; }
+    public void setEspecie(String especie) { this.especie = especie; }
+
+    public String getSexo() { return sexo; }

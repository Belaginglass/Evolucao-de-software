+++ b/src/main/resources/templates/adocao/cadastro-manual.html
@@ -0,0 +1,86 @@
+<!DOCTYPE html>
+<html xmlns:th="http://www.thymeleaf.org">
+<head>
+    <meta charset="UTF-8">
+    <title>DogTech - Cadastro Manual de Adoção [FA-12]</title>
+    <script>
+        function buscarCep() {
+            let cep = document.getElementById('cep').value;
+            fetch('/buscar-cep?cep=' + cep)
+                .then(response => response.json())
+                .then(data => {
+                    if (data && data.rua) {
+                        document.getElementById('rua').value = data.rua;
+                        document.getElementById('bairro').value = data.bairro;
+                        document.getElementById('cidade').value = data.cidade;
+                        document.getElementById('estado').value = data.estado;
+                    }
+                });
+        }
+    </script>
+</head>
+<body>
+    <h2>DogTech - Cadastro Manual de Adoção [PRT-6 / FA-12] (RN014)</h2>
+    <p><a href="/adocoes/fila">Voltar para Fila de Adoções</a></p>
+
+    <div th:if="${erro}" style="color: red;"><p th:text="${erro}"></p></div>
+    <div th:if="${sucesso}" style="color: green;"><p th:text="${sucesso}"></p></div>
+
+    <form action="/adocoes/manual" method="post" enctype="multipart/form-data">
+        <label>Animal Disponível: <span title="Selecione o animal para adoção">?</span></label>
+        <select name="animalId" required>
+            <option th:each="a : ${animais}" th:value="${a.id}" th:text="${a.nomeReferencia} + ' (' + ${a.raca} + ')'"></option>
+        </select><br><br>
+
+        <label>Nome Completo:</label>
+        <input type="text" name="nome" required><br><br>
+
+        <label>E-mail:</label>
+        <input type="text" name="email" required><br><br>
+
+        <label>Senha Provisória (Gerada automaticamente pela Data de Nascimento - RN014):</label>
+        <input type="password" value="senhaautomatica" disabled><br><br>
+
+        <label>CPF:</label>
+        <input type="text" name="cpf" required><br><br>
+
+        <label>Data de Nascimento (Usada como senha DDMMYYYY - RN014):</label>
+        <input type="date" name="dataNascimento" required><br><br>
+
+        <label>Telefone(s):</label>
+        <input type="text" name="telefones" placeholder="(32)99999-9999" required><br><br>
+
+        <label>CEP:</label>
+        <input type="text" id="cep" name="cep" onblur="buscarCep()" required><br><br>
+
+        <label>Rua:</label>
+        <input type="text" id="rua" name="rua" required><br><br>
+
+        <label>Número:</label>
+        <input type="text" name="numero" required><br><br>
+
+        <label>Complemento:</label>
+        <input type="text" name="complemento"><br><br>
+
+        <label>Bairro:</label>
+        <input type="text" id="bairro" name="bairro" required><br><br>
+
+        <label>Cidade:</label>
+        <input type="text" id="cidade" name="cidade" required><br><br>
+
+        <label>Estado:</label>
+        <input type="text" id="estado" name="estado" required><br><br>
+
+        <label>Foto:</label>
+        <input type="file" name="fotoFile" accept=".jpg, .jpeg, .png"><br><br>
+
+        <label>Voluntário?:</label>
+        <select name="voluntario">
+            <option value="Sim">Sim</option>
+            <option value="Não">Não</option>
+        </select><br><br>
+
+        <button type="submit">Cadastrar e Aprovar Adoção Manual</button>
+    </form>
+</body>
+</html>

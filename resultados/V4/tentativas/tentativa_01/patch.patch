+package com.tcc.iterativa.service;
+
+import com.tcc.iterativa.model.ConteudoHome;
+import com.tcc.iterativa.repository.ConteudoHomeRepository;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+@SpringBootTest
+class ConteudoHomeServiceTest {
+
+    @Autowired
+    private ConteudoHomeService service;
+
+    @Autowired
+    private ConteudoHomeRepository repository;
+
+    @BeforeEach
+    void setUp() {
+        repository.deleteAll();
+    }
+
+    @Test
+    void testSalvarEObterSobreNos() {
+        service.salvarSobreNos(
+            "ONG DogTech de Proteção Animal."
+        );
+        String sobre = service.obterSobreNos();
+        assertEquals(
+            "ONG DogTech de Proteção Animal.",
+            sobre
+        );
+    }
+
+    @Test
+    void testAdicionarESelecionarServico() {
+        service.salvarItem(
+            "SERVICO",
+            "Castração",
+            "Mutirão de castração gratuita.",
+            null
+        );
+        List<ConteudoHome> servicos = service.listarServicos();
+        assertEquals(1, servicos.size());
+        assertEquals(
+            "Castração",
+            servicos.get(0).getTitulo()

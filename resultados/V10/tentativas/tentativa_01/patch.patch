diff --git a/src/test/java/com/tcc/iterativa/service/EventoDoacaoRelatorioServiceTest.java b/src/test/java/com/tcc/iterativa/service/EventoDoacaoRelatorioServiceTest.java
new file mode 100644
index 0000000..10ae666
--- /dev/null
+++ b/src/test/java/com/tcc/iterativa/service/EventoDoacaoRelatorioServiceTest.java
@@ -0,0 +1,59 @@
+package com.tcc.iterativa.service;
+
+import com.tcc.iterativa.model.Evento;
+import com.tcc.iterativa.model.PedidoDoacao;
+import com.tcc.iterativa.repository.EventoRepository;
+import com.tcc.iterativa.repository.PedidoDoacaoRepository;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.time.LocalDate;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+@SpringBootTest
+@Transactional
+class EventoDoacaoRelatorioServiceTest {
+
+    @Autowired
+    private EventoDoacaoRelatorioService service;
+
+    @Autowired
+    private EventoRepository eventoRepository;
+
+    @Autowired
+    private PedidoDoacaoRepository pedidoDoacaoRepository;
+
+    @BeforeEach
+    void setUp() {
+        eventoRepository.deleteAll();
+        pedidoDoacaoRepository.deleteAll();
+    }
+
+    @Test
+    void testCriarEListarEventoSucesso() throws Exception {
+        Evento ev = service.salvarEvento("Feira de Adoção", LocalDate.now().plusDays(5), "Feira no parque", null);
+        assertNotNull(ev.getId());
+        assertEquals(1, service.listarEventosPublicos().size());
+    }
+
+    @Test
+    void testCriarEListarPedidoDoacaoSucesso() throws Exception {
+        PedidoDoacao pd = service.salvarPedidoDoacao("Ração para cães", 50.0, "Precisamos de ração", LocalDate.now().plusDays(10), null);
+        assertNotNull(pd.getId());
+        assertEquals(1, service.listarPedidosDoacaoPublicos().size());
+    }
+
+    @Test
+    void testGerarRelatoriosConsolidados() {
+        Map<String, Object> relatorios = service.gerarRelatoriosConsolidados();
+        assertNotNull(relatorios);
+        assertTrue(relatorios.containsKey("totalAnimais"));
+        assertTrue(relatorios.containsKey("totalAdocoes"));
+        assertTrue(relatorios.containsKey("adocoesPorEstado"));
+    }
+}

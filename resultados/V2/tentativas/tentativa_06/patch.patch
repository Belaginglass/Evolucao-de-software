--- /dev/null
+++ b/src/test/java/com/tcc/iterativa/service/UsuarioServiceI2Test.java
@@ -0,0 +1,86 @@
+package com.tcc.iterativa.service;
+
+import com.tcc.iterativa.model.Usuario;
+import com.tcc.iterativa.repository.UsuarioRepository;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+
+import java.time.LocalDate;
+import java.util.Map;
+import java.util.Optional;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+@SpringBootTest
+class UsuarioServiceI2Test {
+
+    @Autowired
+    private UsuarioService usuarioService;
+
+    @Autowired
+    private UsuarioRepository usuarioRepository;
+
+    @BeforeEach
+    void setUp() {
+        usuarioRepository.deleteAll();
+    }
+
+    @Test
+    void testCadastroCompletoSucesso() throws Exception {
+        byte[] fotoMock = new byte[]{1, 2, 3, 4};
+        Usuario u = usuarioService.cadastrar(
+            "novo@dogtech.com", "senha1234", "ADOTANTE",
+            "João Silva", "12345678901", LocalDate.of(1990, 5, 10),
+            "(32)98888-8888 - WhatsApp", "Rua Américo Lobo", "100",
+            "Apto 101", "Bairu", "Juiz de Fora", "MG", "36050000",
+            fotoMock, "Sim"
+        );
+        assertNotNull(u.getId());
+        assertEquals("João Silva", u.getNome());
+        assertEquals("Juiz de Fora", u.getCidade());
+    }
+
+    @Test
+    void testCadastroFalhaSemTelefone() {
+        byte[] fotoMock = new byte[]{1, 2, 3};
+        assertThrows(IllegalArgumentException.class, () -> {
+            usuarioService.cadastrar(
+                "nota@dogtech.com", "senha1234", "ADOTANTE",
+                "Maria", "98765432109", LocalDate.of(1995, 1, 1),
+                "", "Rua X", "10", "", "Bairro Y", "Cidade Z", "MG", "36050000",
+                fotoMock, "Não"
+            );
+        });
+    }
+
+    @Test
+    void testBuscaCepLocal() {
+        Map<String, String> endereco = usuarioService.consultarCep("36050000");
+        assertNotNull(endereco);
+        assertEquals("Rua Américo Lobo", endereco.get("rua"));
+        assertEquals("Juiz de Fora", endereco.get("cidade"));
+    }
+
+    @Test
+    void testAtualizarDadosPessoais() throws Exception {
+        usuarioService.cadastrar(
+            "atualiza@dogtech.com", "senha1234", "ADOTANTE",
+            "Carlos", "11122233344", LocalDate.of(1985, 2, 2),
+            "(32)97777-7777", "Rua Antiga", "1", "", "Bairro A", "JF", "MG", "36050000",
+            null, "Sim"
+        );
+
+        String token = usuarioService.atualizarDadosPessoais(
+            "atualiza@dogtech.com", "Carlos Silva", "11122233344", LocalDate.of(1985, 2, 2),
+            "(32)97777-7777", "Rua Nova", "2", "", "Bairro A", "JF", "MG", "36050000",
+            null, "Não", "novasenha123"
+        );
+
+        assertNotNull(token);
+        Optional<Usuario> uOpt = usuarioService.autenticar("atualiza@dogtech.com", "novasenha123");
+        assertTrue(uOpt.isPresent());
+        assertEquals("Carlos Silva", uOpt.get().getNome());
+    }
+}

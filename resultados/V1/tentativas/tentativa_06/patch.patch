+package com.tcc.iterativa.service;
+
+import com.tcc.iterativa.config.PasswordUtils;
+import com.tcc.iterativa.model.Usuario;
+import com.tcc.iterativa.repository.UsuarioRepository;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+
+import java.util.Optional;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+@SpringBootTest
+class UsuarioServiceTest {
+
+    @Autowired
+    private UsuarioService usuarioService;
+
+    @Autowired
+    private UsuarioRepository usuarioRepository;
+
+    @BeforeEach
+    void setUp() {
+        usuarioRepository.deleteAll();
+    }
+
+    @Test
+    void testCadastroESucessoAutenticacao() throws Exception {
+        usuarioService.cadastrar("teste@dogtech.com", "senha1234", "ADOTANTE");
+        Optional<Usuario> user = usuarioService.autenticar("teste@dogtech.com", "senha1234");
+        assertTrue(user.isPresent());
+    }
+
+    @Test
+    void testCadastroFalhaFormatoEmail() {
+        assertThrows(IllegalArgumentException.class, () -> {
+            usuarioService.cadastrar("emailerrado.com", "senha1234", "ADOTANTE");
+        });
+    }
+
+    @Test
+    void testRecuperacaoSenha() throws Exception {
+        usuarioService.cadastrar("recupera@dogtech.com", "senha1234", "ADOTANTE");
+        String token = usuarioService.gerarTokenRecuperacao("recupera@dogtech.com");
+        assertNotNull(token);
+
+        boolean alterado = usuarioService.alterarSenhaComToken(token, "novasenha123");
+        assertTrue(alterado);
+
+        Optional<Usuario> user = usuarioService.autenticar("recupera@dogtech.com", "novasenha123");
+        assertTrue(user.isPresent());
+    }
+}

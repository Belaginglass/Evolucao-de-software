+package com.tcc.iterativa.controller;
+
+import com.tcc.iterativa.model.Usuario;
+import com.tcc.iterativa.service.AuthService;
+import jakarta.servlet.http.HttpSession;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.stereotype.Controller;
+import org.springframework.ui.Model;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.servlet.mvc.support.RedirectAttributes;
+
+@Controller
+public class AuthController {
+
+    @Autowired
+    private AuthService authService;
+
+    @GetMapping({"/", "/login"})
+    public String exibirPaginaAutenticacao() {
+        return "auth";
+    }
+
+    @PostMapping("/login")
+    public String autenticar(@RequestParam String email,
+                             @RequestParam String senha,
+                             HttpSession session,
+                             RedirectAttributes redirectAttributes) {
+        try {
+            Usuario usuario = authService.autenticar(email, senha);
+            session.setAttribute("usuarioLogado", usuario);
+            if ("ADMIN".equals(usuario.getTipo())) {
+                return "redirect:/home-admin";
+            } else {
+                return "redirect:/home-adotante";
+            }
+        } catch (IllegalArgumentException e) {
+            redirectAttributes.addFlashAttribute("erroLogin", e.getMessage());
+            return "redirect:/login";
+        }
+    }
+
+    @PostMapping("/cadastrar")
+    public String cadastrar(@RequestParam String email,
+                            @RequestParam String senha,
+                            @RequestParam(defaultValue = "ADOTANTE") String tipo,
+                            RedirectAttributes redirectAttributes) {
+        try {
+            authService.cadastrar(email, senha, tipo);
+            redirectAttributes.addFlashAttribute("sucesso", "Cadastro realizado com sucesso! Faça login.");
+        } catch (IllegalArgumentException e) {
+            redirectAttributes.addFlashAttribute("erroCadastro", e.getMessage());
+        }
+        return "redirect:/login";
+    }
+
+    @PostMapping("/recuperar")
+    public String recuperarSenha(@RequestParam String email,
+                                 RedirectAttributes redirectAttributes) {
+        try {
+            authService.solicitarRecuperacaoSenha(email);
+            redirectAttributes.addFlashAttribute("sucessoRecuperacao", "Link de recuperação enviado (simulado no console).");
+        } catch (IllegalArgumentException e) {
+            redirectAttributes.addFlashAttribute("erroRecuperacao", e.getMessage());
+        }
+        return "redirect:/login";
+    }
+
+    @GetMapping("/nova-senha")
+    public String exibirFormularioNovaSenha(@RequestParam String token, Model model) {
+        if (!authService.validarToken(token)) {
+            model.addAttribute("erroToken", "Token inválido ou expirado.");
+            return "auth";
+        }
+        model.addAttribute("token", token);
+        return "nova-senha";
+    }
+
+    @PostMapping("/nova-senha")
+    public String alterarSenhaComToken(@RequestParam String token,
+                                     @RequestParam String novaSenha,
+                                     RedirectAttributes redirectAttributes) {
+        try {
+            authService.alterarSenhaComToken(token, novaSenha);
+            redirectAttributes.addFlashAttribute("sucesso", "Senha alterada com sucesso! Faça login.");
+        } catch (IllegalArgumentException e) {
+            redirectAttributes.addFlashAttribute("erro", e.getMessage());
+            return "redirect:/nova-senha?token=" + token;
+        }
+        return "redirect:/login";
+    }
+
+    @GetMapping("/home-admin")
+    public String homeAdmin(HttpSession session, RedirectAttributes redirectAttributes) {
+        Usuario u = (Usuario) session.getAttribute("usuarioLogado");
+        if (u == null || !"ADMIN".equals(u.getTipo())) {
+            redirectAttributes.addFlashAttribute("erroLogin", "Acesso negado.");
+            return "redirect:/login";
+        }
+        return "home-admin";
+    }
+
+    @GetMapping("/home-adotante")
+    public String homeAdotante(HttpSession session, RedirectAttributes redirectAttributes) {
+        Usuario u = (Usuario) session.getAttribute("usuarioLogado");
+        if (u == null || !"ADOTANTE".equals(u.getTipo())) {
+            redirectAttributes.addFlashAttribute("erroLogin", "Acesso negado.");
+            return "redirect:/login";
+        }
+        return "home-adotante";
+    }
+}

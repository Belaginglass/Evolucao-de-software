+<!DOCTYPE html>
+<html xmlns:th="http://www.thymeleaf.org">
+<head>
+    <meta charset="UTF-8">
+    <title>DogTech - Autenticação</title>
+    <style>
+        body { font-family: Arial, sans-serif; margin: 40px; background-color: #f4f4f4; }
+        .container { background: white; padding: 20px; border-radius: 8px; max-width: 400px; margin: auto; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
+        h2 { color: #333; }
+        .form-group { margin-bottom: 15px; }
+        label { display: block; margin-bottom: 5px; }
+        input[type="text"], input[type="password"] { width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px; }
+        button { background: #5cb85c; color: white; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer; width: 100%; }
+        button:hover { background: #4cae4c; }
+        .alert { color: red; font-size: 0.9em; margin-top: 5px; }
+        .success { color: green; font-size: 0.9em; margin-top: 5px; }
+        .section { margin-top: 30px; border-top: 1px solid #eee; padding-top: 15px; }
+    </style>
+</head>
+<body>
+<div class="container">
+    <h2>DogTech - Autenticação (UC001)</h2>
+
+    <div th:if="${sucesso}" class="success" th:text="${sucesso}"></div>
+    <div th:if="${erroLogin}" class="alert" th:text="${erroLogin}"></div>
+
+    <form th:action="@{/login}" method="post">
+        <div class="form-group">
+            <label>E-mail: <span title="Insira seu e-mail válido">❓</span></label>
+            <input type="text" name="email" required />
+        </div>
+        <div class="form-group">
+            <label>Senha: <span title="Mínimo 8 caracteres, sem caracteres proibidos">❓</span></label>
+            <input type="password" name="senha" required />
+        </div>
+        <button type="submit">Entrar</button>
+    </form>
+
+    <div class="section">
+        <h3>Cadastrar</h3>
+        <div th:if="${erroCadastro}" class="alert" th:text="${erroCadastro}"></div>
+        <form th:action="@{/cadastrar}" method="post">
+            <div class="form-group">
+                <label>E-mail:</label>
+                <input type="text" name="email" required />
+            </div>
+            <div class="form-group">
+                <label>Senha (mín 8 chars):</label>
+                <input type="password" name="senha" required />
+            </div>
+            <button type="submit">Cadastrar</button>
+        </form>
+    </div>
+
+    <div class="section">
+        <h3>Esqueceu sua senha?</h3>
+        <div th:if="${erroRecuperacao}" class="alert" th:text="${erroRecuperacao}"></div>
+        <form th:action="@{/recuperar}" method="post">
+            <div class="form-group"><label>E-mail:</label><input type="text" name="email" required /></div>
+            <button type="submit">Recuperar</button>
+        </form>
+    </div>
+</div>
+</body>
+</html>

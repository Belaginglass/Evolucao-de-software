--- /dev/null
+++ b/src/test/java/com/tcc/iterativa/service/AdocaoServiceI8Test.java
@@ -0,0 +1,109 @@
+package com.tcc.iterativa.service;
+
+import com.tcc.iterativa.model.Adocao;
+import com.tcc.iterativa.model.Animal;
+import com.tcc.iterativa.model.Usuario;
+import com.tcc.iterativa.repository.AdocaoRepository;
+import com.tcc.iterativa.repository.AnimalRepository;
+import com.tcc.iterativa.repository.UsuarioRepository;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.time.LocalDate;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+@SpringBootTest
+@Transactional
+class AdocaoServiceI8Test {
+
+    @Autowired
+    private AdocaoService adocaoService;
+
+    @Autowired
+    private AnimalRepository animalRepository;
+
+    @Autowired
+    private UsuarioRepository usuarioRepository;
+
+    @Autowired
+    private AdocaoRepository adocaoRepository;
+
+    @Autowired
+    private AnimalService animalService;
+
+    @Autowired
+    private UsuarioService usuarioService;
+
+    @BeforeEach
+    void setUp() {
+        adocaoRepository.deleteAll();
+        animalRepository.deleteAll();
+        usuarioRepository.deleteAll();
+    }
+
+    @Test
+    void testFluxoPosAdocaoEClassificacaoEstrelasMenorNotaPrevalece() throws Exception {
+        Animal animal = animalService.cadastrar(
+            "Canina", "Macho", "Sim", "Sim", "2 anos", "Labrador",
+            "Dócil", "Médio", null, "Rex", "História",
+            "Não", "Não", "Sim", null, null, null, "João", null
+        );
+
+        Usuario adotante = usuarioService.cadastrar(
+            "adotante8@dogtech.com", "senha1234", "ADOTANTE",
+            "Adotante I8", "12345678999", LocalDate.of(1990,1,1),
+            "32999999999", "Rua A", "1", null, "Bairro", "JF", "MG", "36050000", null, "Não"
+        );
+
+        Adocao adocao = adocaoService.criarPedidoAdocao(animal.getId(), adotante.getEmail(), true);
+        adocaoService.marcarComoAdotado(adocao.getId());
+
+        assertEquals("ADOTADO", adocaoRepository.findById(adocao.getId()).get().getEstado());
+
+        // Gestor pede feedback e adotante responde
+        adocaoService.pedirFeedback(adocao.getId(), "Como está o pet?");
+        adocaoService.enviarFeedbackAdotante(adocao.getId(), "Está ótimo!", null);
+
+        // Gestor avalia com 5 estrelas
+        adocaoService.avaliarFeedbackGestor(adocao.getId(), 5, false, false, "Muito bom", "ADOTADO");
+        assertEquals(5, usuarioRepository.findById(adotante.getId()).get().getMenorEstrelaAvaliacao());
+
+        // Outra avaliação com nota menor (2 estrelas) -> menor nota deve prevalecer (RF009)
+        adocaoService.avaliarFeedbackGestor(adocao.getId(), 2, false, false, "Problemas posteriores", "ADOTADO");
+        assertEquals(2, usuarioRepository.findById(adotante.getId()).get().getMenorEstrelaAvaliacao());
+    }
+
+    @Test
+    void testRelatoAdotanteAprovacaoEPublicacao() throws Exception {
+        Animal animal = animalService.cadastrar(
+            "Canina", "Macho", "Sim", "Sim", "2 anos", "Labrador",
+            "Dócil", "Médio", null, "Mel", "História",
+            "Não", "Não", "Sim", null, null, null, "João", null
+        );
+
+        Usuario adotante = usuarioService.cadastrar(
+            "adotante_relato@dogtech.com", "senha1234", "ADOTANTE",
+            "Adotante Relato", "98765432111", LocalDate.of(1992,1,1),
+            "32988888888", "Rua B", "2", null, "Bairro", "JF", "MG", "36050000", null, "Não"
+        );
+
+        Adocao adocao = adocaoService.criarPedidoAdocao(animal.getId(), adotante.getEmail(), true);
+        adocaoService.marcarComoAdotado(adocao.getId());
+
+        adocaoService.enviarRelatoAdotante(adocao.getId(), "Ela é maravilhosa em casa!", null);
+        List<Adocao> pendentes = adocaoService.listarRelatosPendentes();
+        assertEquals(1, pendentes.size());
+
+        // Gestor aprova relato
+        adocaoService.aprovarRelato(adocao.getId(), true, null);
+
+        List<Adocao> publicos = adocaoService.listarRelatosAprovadosPublicos();
+        assertEquals(1, publicos.size());
+        assertEquals("Ela é maravilhosa em casa!", publicos.get(0).getRelatoAdotante());
+    }
+}

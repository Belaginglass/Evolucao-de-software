+<!DOCTYPE html>
+<html xmlns:th="http://www.thymeleaf.org">
+<head>
+    <meta charset="UTF-8">
+    <title>DogTech - Animais Adotados [PRT-42]</title>
+</head>
+<body>
+    <h2>DogTech - Relatos de Animais Adotados [PRT-42] (UC010 / RF011)</h2>
+    <p><a href="/">Página Inicial</a> | <a href="/adote-aqui">Adote Aqui</a></p>
+
+    <div th:if="${relatos.empty}">
+        <p>Nenhum relato publicado no momento.</p>
+    </div>
+

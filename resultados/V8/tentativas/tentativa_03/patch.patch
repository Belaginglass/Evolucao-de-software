+<body>
+    <h2>DogTech - Pós-Adoção e Avaliação de Adotantes [PRT-40] (UC010 / RF009 / RF011)</h2>
+    <p><a href="/home-admin">Voltar</a></p>
+
+    <h3>Adoções em Andamento / Concluídas</h3>
+    <table border="1">
+        <thead>
+            <tr>
+                <th>ID</th>
+                <th>Animal</th>
+                <th>Adotante</th>
+                <th>Estado</th>
+                <th>Ações de Pós-Adoção [PRT-35 / PRT-38]</th>
+            </tr>
+        </thead>
+        <tbody>
+            <tr th:each="ad : ${adocoes}">
+                <td th:text="${ad.id}"></td>
+                <td th:text="${ad.animal.nomeReferencia}"></td>
+                <td th:text="${ad.adotante.email} + ' (' + ${ad.adotante.nome} + ')'"></td>
+                <td th:text="${ad.estado}"></td>
+                <td>
+                    <!-- Marcar como adotado se aguardando visita -->
+                    <div th:if="${ad.estado == 'AGUARDANDO_VISITA'}">
+                        <form action="/adocoes/marcar-adotado" method="post">
+                            <input type="hidden" name="adocaoId" th:value="${ad.id}">
+                            <button type="submit">Marcar como 'ADOTADO' (Inicia Pós-Adoção)</button>
+                        </form>
+                    </div>
+                    <!-- Se já for adotado -->
+                    <div th:if="${ad.estado == 'ADOTADO'}">
+                        <form action="/adocoes/pos-adocao/pedir-feedback" method="post">
+                            <input type="hidden" name="adocaoId" th:value="${ad.id}">
+                            <input type="text" name="mensagem" placeholder="Mensagem de pedido de feedback" required>
+                            <button type="submit">Pedir Feedback [PRT-35]</button>
+                        </form>
+                        <div th:if="${ad.respostaFeedbackAdotante != null}" style="background:#f9f9f9; padding:5px; margin-top:5px;">
+                            <p><strong>Resposta do Adotante:</strong> <span th:text="${ad.respostaFeedbackAdotante}"></span></p>
+                            <img th:if="${ad.fotoRelato != null}" th:src="'data:image/jpeg;base64,' + ${ad.fotoRelato}" width="100"/>
+                            
+                            <form action="/adocoes/pos-adocao/avaliar-gestor" method="post">
+                                <input type="hidden" name="adocaoId" th:value="${ad.id}">
+                                <label>Classificação (Estrelas 1-5 - RF009):</label>
+                                <select name="estrelas" required>
+                                    <option value="5">5 - Bom adotante</option>
+                                    <option value="4">4 - Adotante razoável</option>
+                                    <option value="3">3 - Devolveu com justificativa</option>
+                                    <option value="2">2 - Devolveu sem justificativa</option>
+                                    <option value="1">1 - Abandonou / Mal tratou</option>
+                                </select><br>
+                                <label><input type="checkbox" name="necessitaAcompanhamento" value="true"> Necessita de mais acompanhamento?</label><br>
+                                <label><input type="checkbox" name="revogar" value="true" style="color:red;"> Revogar Adoção?</label><br>
+                                <label>Resposta / Comentário:</label>
+                                <input type="text" name="respostaGestor" required><br>
+                                <button type="submit">Salvar Avaliação [PRT-38]</button>
+                            </form>
+                        </div>
+                    </div>
+                </td>
+            </tr>
+        </tbody>
+    </table>
+
+    <hr>
+    <h3>Relatos Pendentes de Aprovação [PRT-40]</h3>
+    <table border="1">
+        <thead>
+            <tr>
+                <th>Adotante</th>
+                <th>Animal</th>
+                <th>Relato</th>
+                <th>Foto</th>
+                <th>Ações</th>
+            </tr>
+        </thead>
+        <tbody>
+            <tr th:if="${relatosPendentes.empty}">
+                <td colspan="5">Nenhum relato pendente.</td>
+            </tr>
+            <tr th:each="r : ${relatosPendentes}">
+                <td th:text="${r.adotante.nome}"></td>
+                <td th:text="${r.animal.nomeReferencia}"></td>
+                <td th:text="${r.relatoAdotante}"></td>
+                <td>
+                    <img th:if="${r.fotoRelato != null}" th:src="'data:image/jpeg;base64,' + ${r.fotoRelato}" width="80"/>
+                </td>
+                <td>
+                    <form action="/adocoes/pos-adocao/aprovar-relato" method="post" style="display:inline;">
+                        <input type="hidden" name="adocaoId" th:value="${r.id}">
+                        <input type="hidden" name="aprovar" value="true">
+                        <button type="submit">Aprovar (Tornar Público)</button>
+                    </form>
+                    <form action="/adocoes/pos-adocao/aprovar-relato" method="post" style="display:inline; margin-left:5px;">
+                        <input type="hidden" name="adocaoId" th:value="${r.id}">
+                        <input type="hidden" name="aprovar" value="false">
+                        <input type="text" name="motivoRemocao" placeholder="Motivo da remoção" required>
+                        <button type="submit" style="color:red;">Remover / Recusar</button>
+                    </form>
+                </td>
+            </tr>
+        </tbody>
+    </table>
+</body>
+</html>

+        <p><strong>Adotante:</strong> <span th:text="${r.adotante.nome}"></span></p>
+        <p><strong>Relato:</strong> <span th:text="${r.relatoAdotante}"></span></p>
+        <div th:if="${r.fotoRelato != null}">
+            <img th:src="'data:image/jpeg;base64,' + ${r.fotoRelato}" width="200"/>
+        </div>
+    </div>
+</body>
+</html>

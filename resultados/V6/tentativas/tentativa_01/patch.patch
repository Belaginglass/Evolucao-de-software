+        assertEquals("Totó", adocao.getAnimal.getNomeReferencia() != null ? adocao.getAnimal().getNomeReferencia() : "");
+    }
+
+    @Test
+    void testCriarPedidoAdocaoFalhaTermoNaoAceito() throws Exception {
+        Animal animal = animalService.cadastrar(
+            "Canina", "Macho", "Sim", "Sim", "2 anos", "Labrador",
+            "Dócil", "Médio", null, "Totó", "História",
+            "Não", "Não", "Sim", null, null, null, "João", null

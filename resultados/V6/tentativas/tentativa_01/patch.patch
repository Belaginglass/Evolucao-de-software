+            "32999999999", "Rua A", "1", null, "Bairro", "JF", "MG", "36050000", null, "Não"
+        );
+
+        Adocao adocao = adocaoService.criarPedidoAdocao(animal.getId(), usuario.getEmail(), true);
+
+        assertNotNull(adocao.getId());

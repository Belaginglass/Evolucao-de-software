+package com.tcc.iterativa.service;
+
+import com.tcc.iterativa.model.Usuario;
+import com.tcc.iterativa.repository.UsuarioRepository;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+@SpringBootTest
+class UsuarioServiceI5Test {
+
+    @Autowired
+    private UsuarioService usuarioService;
+
+    @Autowired
+    private UsuarioRepository usuarioRepository;
+
+    @BeforeEach
+    void setUp() {
+        usuarioRepository.deleteAll();
+    }
+
+    @Test
+    void testListarEAlterarPrivilegiosSucesso() throws Exception {
+        Usuario u1 = usuarioService.cadastrar("diretor@dogtech.com", "senha1234", "DIRETOR_GERAL", "Diretor", "11111111111", java.time.LocalDate.of(1980,1,1), "(32)99999-9999", "Rua A", "1", "", "Bairro", "JF", "MG", "36050000", null, "Sim");
+        Usuario u2 = usuarioService.cadastrar("gestor@dogtech.com", "senha1234", "GESTOR_ADOCAO", "Gestor", "22222222222", java.time.LocalDate.of(1985,1,1), "(32)98888-8888", "Rua B", "2", "", "Bairro", "JF", "MG", "36050000", null, "Sim");
+
+        List<Usuario> admins = usuarioService.listarUsuariosAdministrativos(null, null);
+        assertEquals(2, admins.size());
+
+        usuarioService.alterarPrivilegios(u2.getId(), "DIRETOR_GERAL", "ATIVO");
+        Usuario atualizado = usuarioRepository.findById(u2.getId()).get();
+        assertEquals("DIRETOR_GERAL", atualizado.getPapel());
+    }
+
+    @Test
+    void testFiltroUsuariosAdministrativos() throws Exception {
+        usuarioService.cadastrar("carlos@dogtech.com", "senha1234", "DIRETOR_GERAL", "Carlos", "33333333333", java.time.LocalDate.of(1990,1,1), "(32)97777-7777", "Rua C", "3", "", "Bairro", "JF", "MG", "36050000", null, "Sim");
+        usuarioService.cadastrar("ana@dogtech.com", "senha1234", "GESTOR_ADOCAO", "Ana", "44444444444", java.time.LocalDate.of(1992,1,1), "(32)96666-6666", "Rua D", "4", "", "Bairro", "JF", "MG", "36050000", null, "Sim");
+
+        List<Usuario> filtrados = usuarioService.listarUsuariosAdministrativos("carlos", null);
+        assertEquals(1, filtrados.size());
+        assertEquals("carlos@dogtech.com", filtrados.get(0).getEmail());
+    }
+
+    @Test
+    void testExcluirAcessoAdministrativo() throws Exception {
+        Usuario u = usuarioService.cadastrar("excluir@dogtech.com", "senha1234", "GESTOR_ADOCAO", "Excluir", "55555555555", java.time.LocalDate.of(1995,1,1), "(32)95555-5555", "Rua E", "5", "", "Bairro", "JF", "MG", "36050000", null, "Sim");
+        usuarioService.excluirAcessoAdministrativo(u.getId());
+
+        Usuario uMod = usuarioRepository.findById(u.getId()).get();
+        assertEquals("ADOTANTE", uMod.getPapel());
+    }
+}

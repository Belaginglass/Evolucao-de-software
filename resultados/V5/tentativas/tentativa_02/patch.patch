diff --git a/src/main/resources/templates/usuario/gerenciar.html b/src/main/resources/templates/usuario/gerenciar.html
new file mode 100644
index 0000000..71f0af9
--- /dev/null
+++ b/src/main/resources/templates/usuario/gerenciar.html
@@ -0,0 +1,76 @@
+<!DOCTYPE html>
+<html xmlns:th="http://www.thymeleaf.org">
+<head>
+    <meta charset="UTF-8">
+    <title>DogTech - Manter Privilégio dos Atores [PRT-10]</title>
+</head>
+<body>
+    <h2>DogTech - Gerenciamento de Privilégios [PRT-10] (UC004)</h2>
+    <p><a href="/home-admin">Voltar</a></p>
+
+    <div th:if="${erro}" style="color: red;"><p th:text="${erro}"></p></div>
+    <div th:if="${sucesso}" style="color: green;"><p th:text="${sucesso}"></p></div>
+
+    <!-- [FA-9] Filtros -->
+    <form action="/usuarios/gerenciar" method="get">
+        <label>Buscar por Nome ou E-mail:</label>
+        <input type="text" name="busca" th:value="${busca}">
+        
+        <label>Cargo:</label>
+        <select name="cargoFiltro">
+            <option value="">Todos</option>
+            <option value="DIRETOR_GERAL" th:selected="${cargoFiltro == 'DIRETOR_GERAL'}">Diretor Geral</option>
+            <option value="GESTOR_ADOCAO" th:selected="${cargoFiltro == 'GESTOR_ADOCAO'}">Gestor de Adoção</option>
+            <option value="ADMIN" th:selected="${cargoFiltro == 'ADMIN'}">Administrador</option>
+        </select>
+        
+        <button type="submit">Filtrar</button>
+        <a href="/usuarios/gerenciar"><button type="button">Limpar Filtro</button></a>
+    </form>
+
+    <hr>
+    <table border="1">
+        <thead>
+            <tr>
+                <th>Nome</th>
+                <th>E-mail</th>
+                <th>Papel Atual</th>
+                <th>Status Admin</th>
+                <th>Ações</th>
+            </tr>
+        </thead>
+        <tbody>
+            <tr th:if="${usuarios.empty}">
+                <td colspan="5">Nenhum usuário administrativo encontrado.</td>
+            </tr>
+            <tr th:each="u : ${usuarios}">
+                <td th:text="${u.nome}"></td>
+                <td th:text="${u.email}"></td>
+                <td>
+                    <form action="/usuarios/privilegios" method="post" style="display:inline;">
+                        <input type="hidden" name="usuarioId" th:value="${u.id}">
+                        <select name="papel">
+                            <option value="DIRETOR_GERAL" th:selected="${u.papel == 'DIRETOR_GERAL'}">Diretor Geral</option>
+                            <option value="GESTOR_ADOCAO" th:selected="${u.papel == 'GESTOR_ADOCAO'}">Gestor de Adoção</option>
+                            <option value="ADMIN" th:selected="${u.papel == 'ADMIN'}">Admin</option>
+                        </select>
+                </td>
+                <td>
+                        <select name="statusAdmin">
+                            <option value="ATIVO" th:selected="${u.statusAdmin == 'ATIVO' || u.statusAdmin == null}">Ativo</option>
+                            <option value="DESABILITADO" th:selected="${u.statusAdmin == 'DESABILITADO'}">Desabilitado</option>
+                        </select>
+                </td>
+                <td>
+                        <button type="submit">Salvar</button>
+                    </form>
+                    <form action="/usuarios/excluir" method="post" style="display:inline; margin-left: 5px;">
+                        <input type="hidden" name="usuarioId" th:value="${u.id}">
+                        <button type="submit" onclick="return confirm('Deseja realmente excluir o acesso administrativo permanentemente?');">Excluir Acesso</button>
+                    </form>
+                </td>
+            </tr>
+        </tbody>
+    </table>
+</body>
+</html>
